{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex_IS image business Skill contract",
  "type": "object",
  "required": ["schema_version", "skill_id", "display_name", "description", "references", "reference_policy", "output", "authoring", "execution", "knowledge"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "media_type", "role", "required", "min_count", "max_count", "ordered", "observation_required", "send_to_generation", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "media_type": {"enum": ["image"]},
          "role": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "min_count": {"type": "integer", "minimum": 0},
          "max_count": {"type": ["integer", "null"], "minimum": 0},
          "ordered": {"type": "boolean"},
          "observation_required": {"type": "boolean"},
          "send_to_generation": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "reference_policy": {
      "type": "object",
      "required": ["allowed_slot_ids", "reject_uncontracted_images", "maximum_reference_images_per_scene", "preserve_reference_order"],
      "properties": {
        "allowed_slot_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reject_uncontracted_images": {"type": "boolean"},
        "maximum_reference_images_per_scene": {"type": ["integer", "null"], "minimum": 1},
        "preserve_reference_order": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["media_type", "requires_ratio_confirmation", "supported_ratios"],
      "properties": {
        "media_type": {"const": "image"},
        "layout": {"type": "string"},
        "panel_count": {"type": "integer", "minimum": 1},
        "single_sheet": {"type": "boolean"},
        "equal_panels": {"type": "boolean"},
        "requires_ratio_confirmation": {"type": "boolean"},
        "supported_ratios": {"type": "array", "minItems": 1, "items": {"enum": ["21:9", "16:9", "3:2", "4:3", "1:1", "3:4", "2:3", "9:16"]}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "authoring": {"type": "object"},
    "execution": {"type": "object"},
    "knowledge": {"type": "object"}
  },
  "additionalProperties": false
}

