{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex_IS image business Skill contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "display_name", "description", "input_mode", "references", "reference_policy", "workload", "output", "authoring", "execution", "knowledge", "business_constraints"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63},
    "display_name": {"type": "string", "minLength": 2},
    "description": {"type": "string", "minLength": 8},
    "input_mode": {"enum": ["text_only", "reference_conditioned"]},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "reference_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_slot_ids", "reject_uncontracted_images", "maximum_reference_images_per_scene", "preserve_reference_order"],
      "properties": {
        "allowed_slot_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reject_uncontracted_images": {"const": true},
        "maximum_reference_images_per_scene": {"type": ["integer", "null"], "minimum": 0},
        "preserve_reference_order": {"const": true}
      }
    },
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_count", "candidate_count_per_scene", "batch_allowed"],
      "properties": {"scene_count": {"$ref": "#/$defs/countRange"}, "candidate_count_per_scene": {"$ref": "#/$defs/countRange"}, "batch_allowed": {"type": "boolean"}}
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["media_type", "requires_ratio_confirmation", "supported_ratios"],
      "properties": {
        "media_type": {"const": "image"}, "requires_ratio_confirmation": {"const": true},
        "supported_ratios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["21:9", "16:9", "3:2", "4:3", "1:1", "3:4", "2:3", "9:16"]}}
      }
    },
    "authoring": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_language", "requires_reference_binding", "requires_prompt_confirmation", "user_instruction_priority"],
      "properties": {"primary_language": {"type": "string", "minLength": 2}, "requires_reference_binding": {"type": "boolean"}, "requires_prompt_confirmation": {"const": true}, "user_instruction_priority": {"const": "highest"}}
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_neutral", "single_candidate_entry", "batch_entry", "requires_paid_batch_confirmation", "automatic_retry", "automatic_visual_ranking"],
      "properties": {"provider_neutral": {"const": true}, "single_candidate_entry": {"const": "generate_image"}, "batch_entry": {"const": "batch-image-generation"}, "requires_paid_batch_confirmation": {"const": true}, "automatic_retry": {"const": false}, "automatic_visual_ranking": {"const": false}}
    },
    "knowledge": {
      "type": "object", "additionalProperties": false,
      "required": ["creative_guidance", "failure_cases", "examples"],
      "properties": {"creative_guidance": {"type": "string"}, "failure_cases": {"type": "string"}, "examples": {"type": "string"}, "community_experience": {"type": "string"}}
    },
    "business_constraints": {"type": "object"}
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "media_type", "role", "scope", "required", "min_count", "max_count", "ordered", "observation_required", "send_to_generation", "description"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "media_type": {"const": "image"}, "role": {"type": "string", "minLength": 1}, "scope": {"enum": ["project", "scene"]}, "required": {"type": "boolean"}, "min_count": {"type": "integer", "minimum": 0}, "max_count": {"type": ["integer", "null"], "minimum": 0}, "ordered": {"type": "boolean"}, "observation_required": {"type": "boolean"}, "send_to_generation": {"type": "boolean"}, "description": {"type": "string", "minLength": 1}}
    },
    "countRange": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": ["integer", "null"], "minimum": 1}}}
  }
}

