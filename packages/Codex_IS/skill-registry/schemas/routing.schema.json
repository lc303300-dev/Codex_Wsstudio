{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "skill_id", "aliases", "user_intents", "subjects", "styles", "narrative_patterns", "negative_intents", "priority"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "user_intents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "subjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "styles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "narrative_patterns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "negative_intents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100}
  },
  "additionalProperties": false
}

