{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "project_id", "state", "state_history", "skill", "image_settings", "material_slots", "prompts"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string"},
    "state": {"enum": ["awaiting_materials", "materials_ready", "awaiting_prompt_confirmation", "ready_for_generation", "awaiting_paid_batch_confirmation", "ready_for_batch_generation", "generating", "completed", "partially_completed", "failed"]},
    "state_history": {"type": "array"},
    "skill": {"type": "object"},
    "image_settings": {"type": "object"},
    "material_slots": {"type": "array"},
    "prompts": {"type": "array"},
    "archived_prompts": {"type": "array"},
    "generation": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}

