{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-cs.local/schemas/video-business-skill-contract-v1.json",
  "title": "Codex_CS Video Business Skill Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "display_name", "description", "references", "video", "authoring", "knowledge"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "display_name": {"type": "string", "minLength": 2},
    "description": {"type": "string", "minLength": 20},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "media_type", "role", "description", "required", "min_count", "max_count", "ordered", "observation_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "media_type": {"enum": ["image", "video", "audio"]},
          "role": {"enum": ["identity", "scene", "style", "start_frame", "end_frame", "footage", "music", "sound", "other"]},
          "description": {"type": "string", "minLength": 4},
          "required": {"type": "boolean"},
          "min_count": {"type": "integer", "minimum": 0},
          "max_count": {"type": ["integer", "null"], "minimum": 1},
          "ordered": {"type": "boolean"},
          "observation_required": {"type": "boolean"}
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_required", "allowed_modes"],
      "properties": {
        "reference_required": {"const": true},
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["image2video", "frames2video", "multimodal2video"]}
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_language", "preserve_professional_english", "user_instruction_priority", "timing_strategy", "transition_strategy", "requires_prompt_confirmation", "requires_reference_binding"],
      "properties": {
        "primary_language": {"const": "zh-CN"},
        "preserve_professional_english": {"const": true},
        "user_instruction_priority": {"const": "highest"},
        "timing_strategy": {"enum": ["user_defined", "skill_defined", "adaptive", "even_fallback"]},
        "transition_strategy": {"enum": ["user_defined", "skill_defined", "adaptive", "unspecified"]},
        "requires_prompt_confirmation": {"const": true},
        "requires_reference_binding": {"const": true}
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creative_guidance", "community_experience", "failure_cases", "examples"],
      "properties": {
        "creative_guidance": {"const": "references/creative-guidance.md"},
        "community_experience": {"const": "references/community-experience.md"},
        "failure_cases": {"const": "references/failure-cases.md"},
        "examples": {"const": "references/examples.md"}
      }
    }
  }
}

