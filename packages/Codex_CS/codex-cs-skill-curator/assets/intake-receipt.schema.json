{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-cs.local/schemas/video-skill-intake-receipt-v2.json",
  "title": "Codex_CS Skill Intake Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hash_algorithm", "skill_id", "status", "validator_version", "approved_by", "validated_at", "sources", "package_sha256"],
  "properties": {
    "schema_version": {"const": 2},
    "hash_algorithm": {"const": "codex-cs-package-sha256-v2"},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"const": "published"},
    "validator_version": {"type": "string", "minLength": 1},
    "approved_by": {"const": "user"},
    "validated_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

