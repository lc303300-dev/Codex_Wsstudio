{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-cs.local/schemas/dt-supplement-draft-v1.json",
  "title": "Codex_DT Creative Supplement Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "operation",
    "source_skill_id",
    "generated_by",
    "provenance",
    "quality_rubric",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "draft"},
    "operation": {"const": "supplement_skill_creative_examples"},
    "source_skill_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "generated_by": {"const": "Codex_DT"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_skill_ids", "benchmark_usage", "contract_inference", "topic_rule_copying"],
      "properties": {
        "benchmark_skill_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "benchmark_usage": {"const": "creative_quality_only"},
        "contract_inference": {"const": false},
        "topic_rule_copying": {"const": false}
      }
    },
    "quality_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "assessment"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "assessment": {"type": "string", "minLength": 10}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_examples", "negative_examples", "boundary_examples"],
      "properties": {
        "positive_examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_conditions", "prompt", "why_it_works"],
            "properties": {
              "input_conditions": {"type": "string", "minLength": 8},
              "prompt": {"type": "string", "minLength": 20},
              "why_it_works": {"type": "string", "minLength": 8}
            }
          }
        },
        "negative_examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_conditions", "prompt", "reason", "correction"],
            "properties": {
              "input_conditions": {"type": "string", "minLength": 8},
              "prompt": {"type": "string", "minLength": 8},
              "reason": {"type": "string", "minLength": 8},
              "correction": {"type": "string", "minLength": 8}
            }
          }
        },
        "boundary_examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_conditions", "boundary", "handling", "why"],
            "properties": {
              "input_conditions": {"type": "string", "minLength": 8},
              "boundary": {"type": "string", "minLength": 8},
              "handling": {"type": "string", "minLength": 8},
              "why": {"type": "string", "minLength": 8}
            }
          }
        },
        "optional_creative_guidance": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
