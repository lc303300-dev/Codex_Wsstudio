{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex_CS video Skill project",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "state",
    "skill",
    "video_settings",
    "material_slots",
    "final_images",
    "prompts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "state": {
      "enum": [
        "awaiting_skill_confirmation",
        "awaiting_video_settings",
        "project_initialized",
        "awaiting_image_stage_choice",
        "collecting_user_materials",
        "generating_images",
        "final_images_ready",
        "authoring_prompt",
        "awaiting_prompt_confirmation",
        "revision_requested",
        "dt_revision",
        "prompt_confirmed",
        "generating_video",
        "completed"
      ]
    },
    "skill": {"type": "object"},
    "video_settings": {"type": "object"},
    "material_slots": {"type": "array", "minItems": 1},
    "final_images": {"type": "array"},
    "prompts": {"type": "array"}
    ,"archived_prompts": {"type": "array"}
  },
  "additionalProperties": true
}
