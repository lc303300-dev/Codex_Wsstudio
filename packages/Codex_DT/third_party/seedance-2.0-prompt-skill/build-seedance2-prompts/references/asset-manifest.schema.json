{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/build-seedance2-prompts/asset-manifest.schema.json",
  "title": "Seedance 2.0 prompt asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["surface", "mode", "assets"],
  "properties": {
    "surface": {
      "type": "string",
      "enum": ["generic", "dreamina", "volcengine-zh", "byteplus-api", "fal", "jimeng-zh", "muapi", "higgsfield"]
    },
    "model_variant": {
      "type": "string",
      "enum": ["standard", "fast", "mini"],
      "default": "standard"
    },
    "mode": {
      "type": "string",
      "enum": ["text", "first-frame", "first-last", "multimodal", "edit", "extend", "stitch"]
    },
    "duration": {
      "type": "integer",
      "minimum": 4,
      "maximum": 15
    },
    "ratio": {
      "type": "string",
      "enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16", "adaptive"]
    },
    "resolution": {
      "type": "string",
      "enum": ["480p", "720p", "1080p", "4k"]
    },
    "generate_audio": {
      "type": "boolean"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modality", "index", "tag", "alias", "transport_role", "primary_role", "transfers", "must_not_transfer"],
        "properties": {
          "modality": {
            "type": "string",
            "enum": ["image", "video", "audio"]
          },
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "tag": {
            "type": "string",
            "minLength": 2
          },
          "alias": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "transport_role": {
            "type": "string",
            "enum": ["first_frame", "last_frame", "reference_image", "reference_video", "reference_audio"]
          },
          "primary_role": {
            "type": "string",
            "enum": [
              "identity",
              "wardrobe",
              "product",
              "environment",
              "composition",
              "style",
              "first_frame",
              "last_frame",
              "motion",
              "camera",
              "timing",
              "effect",
              "voice",
              "music",
              "ambience",
              "edit_source",
              "extension_source",
              "other"
            ]
          },
          "transfers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "must_not_transfer": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
