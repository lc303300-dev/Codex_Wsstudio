{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/codex-dt/prompt-revision-request.schema.json",
  "title": "Codex_DT prompt revision request",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "classification",
    "should_search_corpus",
    "corpus_search",
    "current_prompt",
    "current_prompt_sha256",
    "user_feedback",
    "locked_context",
    "locked_context_sha256",
    "revision_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "codex_dt_prompt_revision_request"},
    "classification": {"enum": ["explicit_local", "ambiguous_creative", "structural_rewrite"]},
    "should_search_corpus": {"type": "boolean"},
    "corpus_search": {
      "type": "object",
      "required": ["max_results", "purpose"],
      "properties": {
        "max_results": {"type": "integer", "minimum": 0, "maximum": 3},
        "purpose": {"type": "string"}
      },
      "additionalProperties": false
    },
    "current_prompt": {"type": "string", "minLength": 1},
    "current_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "user_feedback": {"type": "string", "minLength": 1},
    "locked_context": {
      "type": "object",
      "required": ["contract_rules", "material_order", "ratio", "duration_seconds"],
      "properties": {
        "contract_rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "material_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ratio": {"enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "locked_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_policy": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"const": "explicit_local"}}},
      "then": {
        "properties": {
          "should_search_corpus": {"const": false},
          "corpus_search": {"properties": {"max_results": {"const": 0}}}
        }
      },
      "else": {
        "properties": {
          "should_search_corpus": {"const": true},
          "corpus_search": {"properties": {"max_results": {"const": 3}}}
        }
      }
    }
  ],
  "additionalProperties": true
}
