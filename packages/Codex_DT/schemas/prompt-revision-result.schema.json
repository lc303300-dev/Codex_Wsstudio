{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/codex-dt/prompt-revision-result.schema.json",
  "title": "Codex_DT prompt revision result",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "classification",
    "revised_prompt",
    "changed_sections",
    "preserved_unspecified_content",
    "locked_context_sha256",
    "corpus_usage"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "codex_dt_prompt_revision_result"},
    "classification": {"enum": ["explicit_local", "ambiguous_creative", "structural_rewrite"]},
    "revised_prompt": {"type": "string", "minLength": 1},
    "changed_sections": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "preserved_unspecified_content": {"const": true},
    "locked_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_usage": {
      "type": "object",
      "required": ["searched", "matches"],
      "properties": {
        "searched": {"type": "boolean"},
        "matches": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "portable_pattern"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "portable_pattern": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"const": "explicit_local"}}, "required": ["classification"]},
      "then": {
        "properties": {
          "corpus_usage": {
            "properties": {
              "searched": {"const": false},
              "matches": {"maxItems": 0}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
