# Machine-local Codex configuration and backups
config.toml
config.toml.backup-*
*.local.toml

# Credentials and private runtime data
**/.env
**/.env.*
!**/.env.example
**/.codex-image-private/
**/.codex-batch-image-private/
**/.codex-is-private/
**/.codex-flow-private/
**/.pytest_cache/

# Generated data
**/__pycache__/
**/*.pyc
**/outputs/
**/logs/
**/validation/

# Imported upstream repositories keep their own metadata out of the workspace index
packages/Codex_Github/**/.git/
